# Copy to .env, then fill in your own values. .env is gitignored.
# Never paste a real key into a chat, a commit, or a report.

# Groq free-tier key: https://console.groq.com/keys
GROQ_API_KEY=replace_me

# Model the pipeline targets. Free-plan limits are per model, so this choice
# determines every limit we probe and calibrate against.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Where the stand-in model service listens (local-only).
STANDIN_BASE_URL=http://127.0.0.1:8788/v1

# Optional: cap real-provider spend during development. The runner refuses to
# start a scenario it cannot afford from these numbers.
RELAY_MAX_REAL_REQUESTS_PER_RUN=40
